<launch>
    <!-- launch usb_cam package with configure file -->
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" respawn="false" output="screen">
        <rosparam command="load" file="$(find point_cloud_colorizer)/io/config/webcam_params.yml"/>
    </node>

    <!-- launch image_view to see image in topic -->
    <arg name="image_view" default="false" /> 
    <node if="$(arg image_view)" name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/usb_cam/image_raw"/>
        <param name="autosize" value="true" />
    </node>
</launch>
