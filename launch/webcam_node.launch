<launch>
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" respawn="false" output="screen">
        <rosparam command="load" file="$(find point_cloud_colorizer)/io/config/webcam_params.yml"/>
    </node>

    <!-- image undistor -->
    <node pkg="image_proc" type="image_proc" name="image_proc" ns="usb_cam"/>
</launch>
