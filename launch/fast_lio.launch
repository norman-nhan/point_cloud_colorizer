<!-- launch fast_lio2 algorithm, without launching any sensors's driver -->
<launch>
  <rosparam command="load" file="$(find point_cloud_colorizer)/io/config/fast_lio_params.yml" />
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

  <arg name="rviz" default="true" />
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find point_cloud_colorizer)/io/rviz/fast_lio.rviz" />
  </group>
</launch>